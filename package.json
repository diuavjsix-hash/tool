{
  "name": "tool-lab",
  "private": true,
  "version": "2.0.0",
  "description": "Browser-only statistical and scientific calculation tools",
  "homepage": "https://diuavjsix-hash.github.io/tool/",
  "repository": {
    "type": "git",
    "url": "https://github.com/diuavjsix-hash/tool.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check": "pnpm check:docs && pnpm test && pnpm build && pnpm check:bundle"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.9"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jstat": "^1.9.6",
    "lucide-react": "^1.28.0",
    "mathlive": "0.109.1",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.1.17",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.9.0"
}
